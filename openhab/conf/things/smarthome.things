Bridge mqtt:broker:localBroker "Local MQTT Broker" [
    host="mosquitto",
    port=8883,
    secure=true,
    hostnameValidated=false,
    username="openhab",
    password="OpenHabPass123",
    clientID="openhab_mc1"
] {
     Thing topic living_lux "Освітленість вітальні" @ "Вітальня" {
        Channels:
            Type number : telemetry [ stateTopic="home/living_room/lux/telemetry", transformationPattern="JSONPATH:$.value" ]
    }

    Thing topic living_motion "Датчик руху вітальні" @ "Вітальня" {
        Channels:
            Type switch : telemetry [ stateTopic="home/living_room/motion/telemetry", transformationPattern="JSONPATH:$.value" ]
    }

    Thing topic living_light "Світло вітальні" @ "Вітальня" {
        Channels:
            Type switch : state [ stateTopic="home/living_room/light/state", transformationPattern="JSONPATH:$.state" ]
            Type dimmer : brightness [ stateTopic="home/living_room/light/state", transformationPattern="JSONPATH:$.brightness" ]
            Type switch : set [ commandTopic="home/living_room/light/set", formatBeforePublish="{\"state\":\"%s\"}" ]
    }

    Thing topic climate "Клімат" @ "Вітальня" {
        Channels:
            Type number : temperature [ stateTopic="home/main/climate/telemetry", transformationPattern="JSONPATH:$.value" ]
    }

    Thing topic heater "Обігрівач" @ "Вітальня" {
        Channels:
            Type switch : state [ stateTopic="home/living_room/heater/state", transformationPattern="JSONPATH:$.state" ]
            Type switch : set [ commandTopic="home/living_room/heater/set", formatBeforePublish="{\"state\":\"%s\"}" ]
            Type number : setpoint [ commandTopic="home/living_room/heater/set", formatBeforePublish="{\"setpoint\":%s}" ]
    }

    Thing topic power "Лічильник потужності" @ "Кухня" {
        Channels:
            Type number : telemetry [ stateTopic="home/main/power/telemetry", transformationPattern="JSONPATH:$.value" ]
    }
}