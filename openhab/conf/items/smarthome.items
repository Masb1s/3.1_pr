Group SmartHome "Розумна квартира" <house>
Group gLights "Освітлення" <lightbulb> (SmartHome)
Group gClimate "Клімат" <heating> (SmartHome)
Group gSensors "Датчики" <sensor> (SmartHome)
Group gEnergy "Енергоспоживання" <energy> (SmartHome)

Number LivingLux "Освітленість [%d lx]" <sun> (gSensors) { channel="mqtt:topic:localBroker:living_lux:telemetry" }
Switch LivingMotion "Рух [%s]" <motion> (gSensors) { channel="mqtt:topic:localBroker:living_motion:telemetry" }

Switch LivingLight "Світло [%s]" <lightbulb> (gLights) { channel="mqtt:topic:localBroker:living_light:state" }
Dimmer LivingBrightness "Яскравість [%d %%]" <slider> (gLights) { channel="mqtt:topic:localBroker:living_light:brightness" }
Switch LivingLightSet { channel="mqtt:topic:localBroker:living_light:set" }

Number CurrentTemp "Температура [%.1f °C]" <temperature> (gClimate) { channel="mqtt:topic:localBroker:climate:temperature" }

Switch HeaterState "Обігрівач [%s]" <fire> (gClimate) { channel="mqtt:topic:localBroker:heater:state" }
Switch HeaterSet { channel="mqtt:topic:localBroker:heater:set" }
Number HeaterSetpoint "Уставка [%.1f °C]" <temperature> (gClimate) { channel="mqtt:topic:localBroker:heater:setpoint" }

Number PowerUsage "Потужність [%d W]" <energy> (gEnergy) { channel="mqtt:topic:localBroker:power:telemetry" }